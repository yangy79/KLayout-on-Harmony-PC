+//  统计 db 的 stream 格式注册表条数，并给出 typeid 的 name/hash。
+//  这是判断"插件 dlopen 成功但没注册进去"的关键：注册表是
+//  std::map<std::type_index, RegistrarBase*>，比较走 type_info::before()，
+//  而 libc++abi 的 before() 是**指针比较**（__type_name 的地址）。
+//  若 -fvisibility=hidden 让各库的 RTTI name 符号不被动态合并，同一类型在
+//  主程序与插件里的 type_index 就**不相等**，插件注册到自己的键上、
+//  主程序查不到 → 格式表为空 → "Stream has unknown format"。
+static int ohos_format_count ()
+{
+  int n = 0;
+  for (tl::Registrar<db::StreamFormatDeclaration>::iterator it =
+         tl::Registrar<db::StreamFormatDeclaration>::begin ();
+       it != tl::Registrar<db::StreamFormatDeclaration>::end (); ++it) {
+    ++n;
+  }
+  return n;
+}
