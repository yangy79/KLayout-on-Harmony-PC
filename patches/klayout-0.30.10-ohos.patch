+//  stderr 重定向的目标（沙箱内），供 ohos_dump_stderr() 增量读取
+static QByteArray s_err_path;
+
+//  把重定向到沙箱文件的 stderr 内容转投 hilog。KLayout 的 tl::error/tl::warn
+//  只写 std::cerr，在 OHOS 上原本完全不可见 —— 插件加载失败、宏报错等都被吞掉。
+static void ohos_dump_stderr ()
+{
+  if (s_err_path.isEmpty ()) { return; }
+  QFile f (QString::fromUtf8 (s_err_path.constData ()));
+  if (!f.open (QIODevice::ReadOnly)) { return; }
+  QByteArray all = f.readAll ();
+  f.close ();
+  static int s_off = 0;
+  if (all.size () <= s_off) { return; }
+  QByteArray chunk = all.mid (s_off);
+  s_off = all.size ();
+  int p = 0;
+  while (p < (int) chunk.size ()) {
+    int nl = chunk.indexOf ('\n', p);
+    if (nl < 0) { nl = chunk.size (); }
+    QByteArray line = chunk.mid (p, nl - p);
+    if (!line.trimmed ().isEmpty ()) {
+      ohos_dbg ("[stderr] " + std::string (line.constData ()));
+    }
+    p = nl + 1;
+  }
+}
