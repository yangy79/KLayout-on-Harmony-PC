+static void ohos_dump_format_registry ()
+{
+  const std::type_info &ti = typeid (db::StreamFormatDeclaration);
+  char buf[64];
+  snprintf (buf, sizeof (buf), "%p", (const void *) ti.name ());
+  ohos_dbg (std::string ("[fmt] typeid name=") + ti.name () + " addr=" + buf
+            + " hash=" + std::to_string ((long long) ti.hash_code ()));
+  ohos_dbg ("[fmt] registered formats = " + std::to_string (ohos_format_count ()));
+  for (tl::Registrar<db::StreamFormatDeclaration>::iterator it =
+         tl::Registrar<db::StreamFormatDeclaration>::begin ();
+       it != tl::Registrar<db::StreamFormatDeclaration>::end (); ++it) {
+    ohos_dbg ("[fmt]   name='" + it->format_name () + "' file_format='"
+              + it->file_format () + "'");
+  }
+}
